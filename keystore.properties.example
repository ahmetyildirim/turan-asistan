# Bu dosyayı keystore.properties adıyla kopyalayın ve kendi değerlerinizi yazın.
# keystore.properties git'e GİRMEZ (.gitignore). Ortam değişkenleri de kullanılabilir:
# TURAN_STORE_FILE, TURAN_STORE_PASSWORD, TURAN_KEY_ALIAS, TURAN_KEY_PASSWORD
storeFile=my-release.keystore
storePassword=CHANGE_ME
keyAlias=mykey
keyPassword=CHANGE_ME
